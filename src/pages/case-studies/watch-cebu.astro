                  <pre class="overflow-x-auto p-4 font-mono text-xs leading-relaxed text-emerald-300">
                    <code>{item.codeSnippet}</code>
                  </pre>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Mobile-First Civic Ergonomics & Accessibility (WCAG 2.2 AA) -->
    <section class="mt-24" data-reveal>
      <div class="mb-8">
        <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">Human-Centered Design</p>
        <h2 class="mt-1 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Mobile-First Civic Ergonomics (WCAG 2.2 AA)
