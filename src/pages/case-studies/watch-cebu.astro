---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";

const metrics = [
  {
    label: "Automated Test Suite",
    value: "270 / 270",
    unit: "Tests Passed",
    subtext: "22 Vitest test suites with 100% parser coverage & SHA-256 pre/post directory guards",
    accent: "text-emerald-400",
    badge: "100% Passing",
  },
  {
    label: "Global Edge Latency",
    value: "< 100",
    unit: "ms Edge Response",
    subtext: "Vercel Edge Functions with s-maxage=60 & stale-while-revalidate=300 HTTP headers",
    accent: "text-primary",
    badge: "Edge CDN",
  },
  {
    label: "Client Bundle Footprint",
    value: "~78",
    unit: "kB Gzipped",
    subtext: "Zero-framework runtime: Vanilla TypeScript 5, Leaflet 1.9.4 & modern CSS custom properties",
    accent: "text-sky-400",
    badge: "Zero Bloat",
  },
  {
    label: "Infrastructure Cost",
    value: "$0",
    unit: "Per Month",
    subtext: "Production civic infrastructure operating perpetually inside free-tier platform quotas",
    accent: "text-amber-400",
    badge: "Zero-Cost",
  },
];

const challenges = [
  {
    id: "01",
    tag: "Deployment Optimization · ADR-005",
    title: "Overcoming Vercel’s 100-Deploy/Day Free-Tier Limit",
    problem:
      "Scheduled GitHub Actions crons ingest fresh earthquake bulletins and power outage notices every 10 minutes, generating up to 150 automated commits/day. On Vercel Hobby, a hard cap of 100 builds per day meant production deployments would freeze before 5:00 PM daily.",
    solution:
      "Implemented an intelligent Ignored Build Step script (scripts/vercel-ignore-build.sh) configured via vercel.json. The script inspects the commit diff: if changes are isolated strictly to data/, Vercel exits 0 and cancels deployment. Full builds trigger only when code, styling, or configuration files change outside data/.",
    codeSnippet: `#!/usr/bin/env bash
# scripts/vercel-ignore-build.sh
# Exit 0 = Skip build (data-only snapshot updates)
# Exit 1 = Proceed with build (application code modified)
git diff --quiet HEAD^ HEAD -- . ':(exclude)data'`,
    result: "Automated daily deployment consumption dropped from ~150/day to 0, completely safeguarding deploy quotas while keeping civic data continuously live.",
  },
  {
    id: "02",
    tag: "Data Ingestion & Distributed Caching",
    title: "Runtime GitHub Raw Snapshot Distribution with Stale-While-Revalidate",
    problem:
      "Because data snapshots were decoupled from deployment artifacts, the frontend required a resilient mechanism to fetch live snapshots without incurring database overhead or exceeding upstream GitHub API rate limits under traffic surges.",
    solution:
      "Engineered Vercel Serverless Edge API routes (/api/power and /api/earthquakes) utilizing a pluggable ISnapshotSource interface. The edge layer fetches directly from GitHub Raw CDN and emits HTTP caching directives: s-maxage=60, stale-while-revalidate=300.",
    codeSnippet: `// server/api.ts & api/power.ts
res.setHeader(
  "Cache-Control",
  "public, s-maxage=60, stale-while-revalidate=300"
);
return res.status(200).json({
  data_source: "snapshot",
  fetched_at: new Date().toISOString(),
  data: snapshot.advisories
});`,
    result: "Function executions are capped at at most 1 invocation per minute worldwide (~1,440/day maximum), well within Vercel's 100k/month allowance, with built-in fallback to bundled offline fixtures if GitHub Raw is unreachable.",
  },
  {
    id: "03",
    tag: "Deterministic Testing & Data Integrity",
    title: "SHA-256 Checksum Guards & Dynamic Test Isolation",
    problem:
      "Running local Vitest test suites executed parser and scraper modules that risked mutating authentic live JSON snapshots in data/, which could inadvertently cause stale fixture data to be committed to production.",
    solution:
      "Architected dynamic runtime data directory redirection using WATCH_CEBU_DATA_DIR, routing test runs to isolated temporary fixture directories. Combined with a global pre/post test suite guard (globalDataGuard.ts) that hashes all authentic data files with SHA-256 and aborts if any file hash deviates.",
    codeSnippet: `// tests/setup/globalDataGuard.ts
const preHashes = calculateDirSha256("data/");
// ... execute test suite ...
const postHashes = calculateDirSha256("data/");
if (hasChecksumMismatch(preHashes, postHashes)) {
  throw new Error("DATA MUTATION DETECTED: Test suite modified authentic live snapshots!");
}`,
    result: "100% reproducible testing across 22 test suites and 270 test cases without dirtying git working trees or risking civic data corruption.",
  },
];

const galleryScreens = [
  {
    src: "/project-images/WatchCebu/dashboard-map.png",
    alt: "Watch Cebu dark control room dashboard overview",
    number: "01",
    title: "Real-Time Spatial Control Room",
    category: "Geospatial Interface · Leaflet 1.9.4",
    caption:
      "CartoDB Dark Matter basemap strictly bounded to Metro Cebu & Visayas (viscosity: 1.0, 300 km radius) with live power outage pins, seismic markers, and header status chips.",
  },
  {
    src: "/project-images/WatchCebu/incident-popup.png",
    alt: "VECO power interruption modal with street-level parsing",
    number: "02",
    title: "Granular Street & Landmark Parsing",
    category: "NLP & Ingestion · Heuristic RegEx",
    caption:
      "Custom extractStreets engine parses unstructured utility notices, preserving street initialisms and providing direct verification links back to official utility advisories.",
  },
  {
    src: "/project-images/WatchCebu/forecast-drawer.png",
    alt: "Top slide-down 24-hour weather forecast drawer",
    number: "03",
    title: "Lightweight 24-Hour Forecast Drawer",
    category: "Micro-UX · Open-Meteo API",
    caption:
      "Replaced heavy 2+ MB Doppler radar tiles with a slide-down horizontal drawer showing hourly WMO weather codes, rain probabilities (🌧️ %), and wind speeds.",
  },
  {
    src: "/project-images/WatchCebu/mobile-responsive.png",
    alt: "Mobile-first responsive layout on iPhone SE",
    number: "04",
    title: "Mobile-First Clamped Ergonomics (WCAG 2.2 AA)",
    category: "Accessibility & Mobile Field UX",
    caption:
      "Compact 52px top bar and 56px bottom navigation with 44×44px minimum touch targets and zero horizontal scroll, designed for rapid field use during cellular blackouts.",
  },
];

const techStack = [
  {
    layer: "Frontend Engine",
    tech: "TypeScript 5, Vite 7, HTML5, Vanilla CSS3",
    detail: "Zero UI framework overhead, achieving ~78 kB gzipped total bundle size with instant cold-start time",
  },
  {
    layer: "Mapping & GIS",
    tech: "Leaflet 1.9.4, CartoDB Dark Matter Tiles",
    detail: "High-performance vector rendering with strict regional bounds clamping (minZoom: 7, bounds: [7.4, 120.9] to [13.2, 126.9])",
  },
  {
    layer: "Edge & Serverless",
    tech: "Vercel Edge Functions, Node.js 22+",
    detail: "Sub-second API latency with HTTP s-maxage=60 and stale-while-revalidate=300 caching",
  },
  {
    layer: "Ingestion & Pipelines",
    tech: "GitHub Actions Scheduled Workflows (10-min crons)",
    detail: "Automated data harvesting from DOST-PHIVOLCS seismic feeds and VECO interruption tables",
  },
  {
    layer: "Parsers & NLP",
    tech: "Cheerio, Axios, Custom Regex Heuristics",
    detail: "Extracts street names without period truncation; SHA-256 deterministic advisory deduplication",
  },
  {
    layer: "External Feeds",
    tech: "Open-Meteo Air Quality & Weather API, VECO Portal, DOST-PHIVOLCS",
    detail: "Multi-tier US AQI, PM2.5, PM10, CO, AOD, transboundary smoke haze callouts, and 24h weather horizon",
  },
  {
    layer: "Testing & Verification",
    tech: "Vitest (270 tests across 22 suites), Chrome DevTools Protocol (CDP)",
    detail: "100% test coverage on scrapers & math; automated headless mobile viewport and a11y audits",
  },
];
---

<Layout>
  <!-- Ambient High-Tech Glow (matching Portfolio Hero) -->
  <div class="case-study-ambient" aria-hidden="true">
    <span class="ambient-orb ambient-orb-primary"></span>
    <span class="ambient-orb ambient-orb-secondary"></span>
    <span class="ambient-grid"></span>
  </div>

  <article class="relative z-10 pt-8 pb-24">
    <!-- Breadcrumb / Back Link -->
    <nav class="mb-10" aria-label="Breadcrumb">
      <a
        href="/#projects"
        class="group inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold tracking-wider text-white/70 uppercase transition hover:border-primary/40 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span class="transition-transform duration-200 group-hover:-translate-x-1" aria-hidden="true">←</span>
        Back to Featured Projects
      </a>
    </nav>

    <!-- Case Study Hero Header -->
    <header class="border-b border-white/10 pb-16" data-reveal>
      <div class="mb-6 flex flex-wrap items-center gap-3 text-xs font-semibold tracking-[0.14em] uppercase">
        <span class="rounded-full bg-primary/20 px-3.5 py-1.5 text-primary">
          Production Case Study
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-white/70">
          Civic Tech · Distributed Systems · Web Mapping
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3.5 py-1.5 text-emerald-300">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></span>
          Live in Production
        </span>
      </div>

      <h1 class="font-serif text-4xl font-bold tracking-tightest text-white sm:text-5xl md:text-6xl lg:text-7xl">
        Watch Cebu: Engineering an Offline-First, Zero-Cost Civic Hazard Dashboard
      </h1>

      <p class="mt-8 max-w-4xl text-lg font-normal leading-relaxed text-neutral md:text-xl">
        A high-availability civic awareness and multi-hazard monitoring platform for Metro Cebu that unifies municipal
        power interruptions, seismic events within 300 km, atmospheric air quality, and hourly weather forecasts—engineered
        with zero UI framework bloat, sub-second edge latency, and a $0/month infrastructure footprint.
      </p>

      <!-- Project Metadata Card -->
      <div class="mt-10 grid gap-4 rounded-2xl border border-white/10 bg-[#151d27]/80 p-6 backdrop-blur sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">Role</dt>
          <dd class="mt-1 font-serif text-base font-semibold text-white">Creator & Full-Stack Systems Engineer</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">Timeline</dt>
          <dd class="mt-1 font-serif text-base font-semibold text-white">September – October 2026</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">Target Region</dt>
          <dd class="mt-1 font-serif text-base font-semibold text-white">Metro Cebu, Philippines</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">License & Model</dt>
          <dd class="mt-1 font-serif text-base font-semibold text-emerald-400">Open Source (MIT) · $0/mo</dd>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-4 text-sm font-semibold">
        <a
          href="https://watch-cebu.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-white shadow-lg shadow-primary/20 transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >
          Launch Live Dashboard <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/Sceyo/Watch-Cebu"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-4 text-white transition hover:border-white/40 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          View GitHub Repository <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://www.linkedin.com/in/francis-aliser/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-6 py-4 text-neutral transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >
          Author: Francis Aliser <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <!-- Key Performance Metrics Grid -->
    <section class="mt-16" data-reveal aria-labelledby="metrics-title">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">Production Benchmarks</p>
          <h2 id="metrics-title" class="mt-1 font-serif text-3xl font-bold tracking-tight text-white">
            Key Architecture & Reliability Metrics
          </h2>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          metrics.map((item) => (
            <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-[#151d27] p-7 shadow-xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-2xl hover:shadow-primary/10">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold tracking-wider text-white/50 uppercase">
                  {item.label}
                </span>
                <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-[0.7rem] font-semibold text-white/70">
                  {item.badge}
                </span>
              </div>
              <div class="mt-4 flex items-baseline gap-1.5">
                <p class={`font-serif text-4xl font-extrabold tracking-tight ${item.accent}`}>
                  {item.value}
                </p>
                <span class="text-xs font-semibold text-white/60 uppercase">{item.unit}</span>
              </div>
              <p class="mt-3 text-xs leading-5 text-neutral">{item.subtext}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- The Problem & Civic Motivation -->
    <section class="mt-20" data-reveal>
      <div class="mb-8">
        <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">The Civic Dilemma</p>
        <h2 class="mt-1 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Critical Data Fragmentation During Municipal Emergencies
        </h2>
      </div>

      <div class="grid gap-8 lg:grid-cols-12">
        <div class="space-y-5 text-base leading-relaxed text-neutral lg:col-span-7">
          <p>
            Metro Cebu is one of the Philippines’ premier economic and metropolitan hubs. Yet, when severe natural or
            infrastructure hazards occur, its civic warning systems break down into siloed, inaccessible fragments.
          </p>
          <p>
            Scheduled power maintenance notices affecting hundreds of thousands of households are routinely published
            as static image flyers on utility social media accounts. Seismic bulletins from DOST-PHIVOLCS are dispersed
            across raw RSS lists without spatial context. Seasonal transboundary smoke haze transported by the southwest
            monsoon (<em>habagat</em>) from regional forest fires is rarely aggregated alongside ground-level air quality
            sensors.
          </p>
          <p>
            During real-world emergencies, commercial mapping apps are the first to fail: loading 5+ megabytes of third-party
            frameworks, ad trackers, and heavy vector tile layers that timeout on spotty 3G/LTE mobile cell towers under
            congested conditions.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-[#151d27] p-8 lg:col-span-5">
          <h3 class="font-serif text-xl font-semibold text-white">Why Conventional Systems Fail:</h3>
          <ul class="mt-6 space-y-4 text-sm text-neutral">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-500/20 text-xs font-bold text-red-400">✕</span>
              <span><strong>Ad & Tracker Bloat:</strong> Commercial portals average 5–12 MB payload per page view, stalling on degraded cellular towers.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-500/20 text-xs font-bold text-red-400">✕</span>
              <span><strong>Unstructured Text Tables:</strong> Outages listed as raw text dumps without street extraction or map coordinates.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-500/20 text-xs font-bold text-red-400">✕</span>
              <span><strong>Paywalls & Quotas:</strong> Civic hazard alerts locked behind proprietary subscriptions or API credit burn.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400">✓</span>
              <span><strong>The Watch Cebu Solution:</strong> A unified, zero-cost, ~78 kB offline-first control room engineered for instant emergency legibility.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Architecture & Pipeline Flowchart -->
    <section class="mt-20" data-reveal>
      <div class="mb-8">
        <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">Pipeline Engineering</p>
        <h2 class="mt-1 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
          High-Availability Serverless Architecture
        </h2>
        <p class="mt-2 text-base text-neutral">
          Decoupled automation, flat repository snapshot storage, and edge-cached distribution operating with $0/month infrastructure cost.
        </p>
      </div>

      <!-- Modern Card-Based Architecture Visualization -->
      <div class="grid gap-4 lg:grid-cols-4">
        <!-- Stage 1 -->
        <div class="relative rounded-3xl border border-white/10 bg-[#151d27] p-6 shadow-xl">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold tracking-wider text-primary uppercase">Stage 01</span>
            <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[0.7rem] font-semibold text-primary">Cron Workers</span>
          </div>
          <h3 class="mt-4 font-serif text-xl font-bold text-white">Ingestion &amp; Parsing</h3>
          <p class="mt-2 text-xs leading-5 text-neutral">
            GitHub Actions scheduled runners execute 10-minute crons with Cheerio and NLP regex:
          </p>
          <ul class="mt-4 space-y-2 text-xs text-white/80">
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <strong class="text-white">VECO Scraper:</strong> Heuristic <code class="text-primary">extractStreets</code> without period truncation; SHA-256 deduplication.
            </li>
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <strong class="text-white">PHIVOLCS Scraper:</strong> 300 km Haversine radius filter around Cebu City (<code class="text-primary">10.3157°N, 123.8854°E</code>).
            </li>
          </ul>
        </div>

        <!-- Stage 2 -->
        <div class="relative rounded-3xl border border-white/10 bg-[#151d27] p-6 shadow-xl">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold tracking-wider text-emerald-400 uppercase">Stage 02</span>
            <span class="rounded-full bg-emerald-400/10 px-2.5 py-0.5 text-[0.7rem] font-semibold text-emerald-300">Git Storage</span>
          </div>
          <h3 class="mt-4 font-serif text-xl font-bold text-white">Flat Git Snapshots</h3>
          <p class="mt-2 text-xs leading-5 text-neutral">
            Committed directly to public repository as versioned flat JSON/GeoJSON snapshots:
          </p>
          <ul class="mt-4 space-y-2 text-xs text-white/80">
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <code class="text-emerald-400">live_power_advisories.json</code>
            </li>
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <code class="text-emerald-400">live_earthquake_events.json</code>
            </li>
            <li class="text-[0.75rem] text-neutral">
              Zero database hosting costs; 100% public transparency and historical audibility.
            </li>
          </ul>
        </div>

        <!-- Stage 3 -->
        <div class="relative rounded-3xl border border-white/10 bg-[#151d27] p-6 shadow-xl">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold tracking-wider text-sky-400 uppercase">Stage 03</span>
            <span class="rounded-full bg-sky-400/10 px-2.5 py-0.5 text-[0.7rem] font-semibold text-sky-300">Edge Caching</span>
          </div>
          <h3 class="mt-4 font-serif text-xl font-bold text-white">Serverless Edge APIs</h3>
          <p class="mt-2 text-xs leading-5 text-neutral">
            Vercel Serverless Functions serve dynamic endpoints backed by Edge CDN headers:
          </p>
          <ul class="mt-4 space-y-2 text-xs text-white/80">
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <code class="text-sky-300">s-maxage=60</code> + <code class="text-sky-300">stale-while-revalidate=300</code>
            </li>
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <strong class="text-white">GitHub Raw Fallback:</strong> Fetches latest raw commit if local build cache expires.
            </li>
            <li class="text-[0.75rem] text-neutral">
              Max 1 execution/min worldwide; zero 500 error propagation to users.
            </li>
          </ul>
        </div>

        <!-- Stage 4 -->
        <div class="relative rounded-3xl border border-white/10 bg-[#151d27] p-6 shadow-xl">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold tracking-wider text-amber-400 uppercase">Stage 04</span>
            <span class="rounded-full bg-amber-400/10 px-2.5 py-0.5 text-[0.7rem] font-semibold text-amber-300">Client Runtime</span>
          </div>
          <h3 class="mt-4 font-serif text-xl font-bold text-white">Leaflet Control Room</h3>
          <p class="mt-2 text-xs leading-5 text-neutral">
            High-performance vanilla TypeScript client on CartoDB Dark Matter basemap:
          </p>
          <ul class="mt-4 space-y-2 text-xs text-white/80">
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <strong class="text-white">Strict Viewport Clamping:</strong> Viscosity 1.0, 300 km regional bounding.
            </li>
            <li class="rounded-lg bg-black/40 p-2.5 border border-white/5">
              <strong class="text-white">WCAG 2.2 AA Chrome:</strong> 52px top, 56px bottom, 44px tap targets.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Deep-Dive Technical Challenges (ADR-005) -->
    <section class="mt-24 space-y-12" data-reveal>
      <div>
        <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">Architecture Decision Records</p>
        <h2 class="mt-1 font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Key Engineering Challenges &amp; Production Solutions
        </h2>
        <p class="mt-2 text-base text-neutral">
          How we engineered around cloud platform limits, upstream rate-limiting, and test suite contamination.
        </p>
      </div>

      <div class="space-y-8">
        {
          challenges.map((item) => (
            <div class="overflow-hidden rounded-3xl border border-white/10 bg-[#151d27] shadow-2xl">
              <div class="border-b border-white/10 bg-black/20 p-6 sm:p-8">
                <div class="flex flex-wrap items-center justify-between gap-4">
                  <span class="rounded-full bg-primary/20 px-3.5 py-1 text-xs font-semibold text-primary">
                    {item.tag}
                  </span>
                  <span class="font-mono text-xs font-bold text-white/40">CHALLENGE {item.id}</span>
                </div>
                <h3 class="mt-3 font-serif text-2xl font-bold text-white sm:text-3xl">
                  {item.title}
                </h3>
              </div>

              <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-2">
                <div class="space-y-4 text-sm leading-relaxed text-neutral">
                  <div>
                    <h4 class="font-serif text-base font-semibold text-red-400">The Problem &amp; Bottleneck</h4>
                    <p class="mt-1.5">{item.problem}</p>
                  </div>
                  <div>
                    <h4 class="font-serif text-base font-semibold text-emerald-400">The Architectural Solution</h4>
                    <p class="mt-1.5">{item.solution}</p>
                  </div>
