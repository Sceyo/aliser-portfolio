---
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";

const metrics = [
  {
    label: "Automated Tests",
    value: "270 / 270",
    subtext: "22 Vitest test suites, 100% parser coverage & SHA-256 data guards",
  },
  {
    label: "Edge Response Latency",
    value: "< 100ms",
    subtext: "Vercel Edge Functions with s-maxage=60, stale-while-revalidate=300",
  },
  {
    label: "Client Bundle Size",
    value: "~78 kB",
    subtext: "Gzipped total footprint (Zero UI framework bloat, Vanilla TS + Leaflet)",
  },
  {
    label: "Production Cost",
    value: "$0 / month",
    subtext: "High-availability civic pipeline operating completely within free-tier caps",
  },
];

const galleryScreens = [
  {
    src: "/project-images/WatchCebu/dashboard-map.png",
    alt: "Watch Cebu control room map interface overview",
    title: "1. Control Room Map & Incident Layers",
    description:
      "CartoDB Dark Matter basemap bounded strictly to Metro Cebu and Visayas (viscosity: 1.0, 300 km radius) with real-time status chips and date selector tabs.",
  },
  {
    src: "/project-images/WatchCebu/incident-popup.png",
    alt: "VECO power interruption modal with street-level parsing",
    title: "2. Heuristic Street & Landmark Parsing",
    description:
      "Heuristic NLP street parser extracts specific street names, maintenance purposes, and provenance markers with direct verification links back to official utility advisories.",
  },
  {
    src: "/project-images/WatchCebu/forecast-drawer.png",
    alt: "Watch Cebu top slide-down 24-hour weather forecast drawer",
    title: "3. Top Slide-down 24-Hour Forecast Horizon",
    description:
      "Replaced heavy Doppler radar tiles with a scannable, lightweight horizontal drawer showing hourly WMO weather codes, rain probabilities (🌧️ %), and wind speeds.",
  },
  {
    src: "/project-images/WatchCebu/mobile-responsive.png",
    alt: "Watch Cebu mobile-first responsive layout on iPhone SE",
    title: "4. Mobile-First Viewport Clamping (WCAG 2.2 AA)",
    description:
      "Clamped 52px header and 56px bottom navigation with 44×44px minimum touch targets and zero horizontal scroll, designed for rapid field use during blackouts.",
  },
];
---

<Layout>
  <article class="pt-8 pb-20">
    <!-- Breadcrumb -->
    <nav class="mb-8" aria-label="Breadcrumb">
      <a
        href="/#projects"
        class="inline-flex items-center gap-2 text-sm font-medium text-white/60 transition hover:text-primary"
      >
        <span aria-hidden="true">←</span> Back to Featured Projects
      </a>
    </nav>

    <!-- Header & Hero -->
    <header class="border-b border-white/10 pb-12" data-reveal>
      <div class="mb-4 flex flex-wrap items-center gap-2 text-xs font-semibold tracking-wider uppercase">
        <span class="rounded-full bg-primary/20 px-3 py-1 text-primary">
          Production Case Study
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-white/70">
          Civic Tech · Distributed Systems · Web Mapping
        </span>
        <span class="text-emerald-400">● Live in Production</span>
      </div>

      <h1 class="font-serif text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Watch Cebu: Engineering an Offline-First, Zero-Cost Civic Hazard Dashboard
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/80 sm:text-xl">
        A real-time civic awareness platform for Metro Cebu that unifies municipal power interruptions,
        seismic events within 300 km, atmospheric air quality, and 24-hour weather forecasts—engineered
        with zero framework bloat, sub-second edge latency, and a $0/month infrastructure footprint.
      </p>

      <!-- Action Links -->
      <div class="mt-8 flex flex-wrap items-center gap-4 text-sm font-semibold">
        <a
          href="https://watch-cebu.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 text-black font-semibold transition hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          Launch Live Dashboard <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/Sceyo/Watch-Cebu"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/5 px-5 py-3 text-white transition hover:border-white/40 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          View GitHub Source <span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://www.linkedin.com/in/francis-aliser/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-transparent px-4 py-3 text-white/70 transition hover:text-white"
        >
          Creator: Francis Aliser <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <!-- Key Metrics Grid -->
    <section class="mt-12" data-reveal aria-labelledby="metrics-heading">
      <h2 id="metrics-heading" class="sr-only">Key Performance Metrics</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          metrics.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-[#151d27] p-6 shadow-lg shadow-black/20">
              <span class="text-xs font-semibold tracking-wider text-white/50 uppercase">
                {item.label}
              </span>
              <p class="mt-2 font-serif text-3xl font-bold text-primary">
                {item.value}
              </p>
              <p class="mt-2 text-xs leading-5 text-white/70">{item.subtext}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- The Problem & Context -->
    <section class="mt-16 space-y-6" data-reveal>
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
        The Civic Problem: Critical Data Fragmentation During Emergencies
      </h2>
      <div class="space-y-4 text-base leading-7 text-white/80">
        <p>
          Metro Cebu is one of the Philippines’ densest metropolitan economic corridors, yet its civic emergency
          information is fragmented across siloed channels: scheduled power outages are published as tabular images on
          utility social media pages, seismic bulletins are dispersed across DOST-PHIVOLCS RSS feeds, and air quality
          haze alerts remain inaccessible to ordinary citizens.
        </p>
        <p>
          During unannounced power outages or seasonal <em>habagat</em> (monsoon) smoke haze transported from regional
          wildfires, citizens and small business operators are forced to comb through multiple ad-heavy portals. Under
          strained mobile connectivity, commercial mapping applications that load 5+ MB of tracking scripts and
          third-party frameworks routinely stall or fail to render.
        </p>
        <p>
          <strong>Watch Cebu was built to solve this:</strong> an open-source, zero-cost, high-reliability control room
          designed to operate on spotty cellular data with a ~78 kB gzipped footprint, unified geospatial layers, and
          zero advertising trackers.
        </p>
      </div>
    </section>

    <!-- System Architecture Diagram -->
    <section class="mt-16" data-reveal>
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
        System Architecture: High-Availability Serverless Pipeline
      </h2>
      <p class="mt-3 text-base text-white/70">
        Decoupled ingestion, flat git snapshot storage, and edge-cached serverless delivery operating with zero ongoing
        infrastructure costs.
      </p>

      <div class="mt-6 overflow-x-auto rounded-2xl border border-white/10 bg-[#0c1219] p-6 font-mono text-xs text-white/80 sm:p-8">
        <pre class="leading-relaxed">
┌────────────────────────────────────────────────────────────────────────────────────────┐
│                        WATCH CEBU AUTOMATION &amp; EDGE PIPELINE                          │
└────────────────────────────────────────────────────────────────────────────────────────┘

  [1. INGESTION ENGINE]
  GitHub Actions Scheduled Workflows (10-min crons)
    │
    ├──► VECO Scraper: Cheerio HTML Table Parser + NLP Street Extractor (extractStreets)
    │    └── Deduplication via SHA-256 Hashes
    │
    └──► DOST-PHIVOLCS Scraper: Seismic Bulletin Ingestion + 300 km Haversine Radius Filter
         └── Magnitude, Depth &amp; Option C SVG Pulse Markers
    │
    ▼
  [2. VERSIONED DATA SNAPSHOTS]
  Committed flat JSON snapshots to public repository:
    • `data/live_power_advisories.json`
    • `data/live_earthquake_events.json`
    │
    ▼
  [3. EDGE DISTRIBUTION &amp; REVALIDATION]
  Vercel Serverless Edge Functions (`/api/power`, `/api/earthquakes`)
    ├── HTTP Headers: `Cache-Control: s-maxage=60, stale-while-revalidate=300`
    ├── Runtime GitHub Raw Fetch (`raw.githubusercontent.com/.../data/*.json`)
    └── Graceful Offline Fixture Fallback (Zero 500 error propagation)
    │
    ▼
  [4. LIGHTWEIGHT CLIENT FRONTEND]
  Zero-framework TypeScript runtime on Leaflet 1.9.4 &amp; CartoDB Dark Matter
    ├── Strict Viewport Clamping (Bounds [7.4, 120.9] to [13.2, 126.9], Viscosity: 1.0)
    ├── Slide-down 24-Hour Forecast Drawer (WMO weather codes, Rain %, Wind km/h)
    └── WCAG 2.2 AA Clamped Mobile Chrome (52px header, 56px bottom bar, 44px tap targets)
        </pre>
      </div>
    </section>

    <!-- Key Engineering Highlights & Challenges -->
    <section class="mt-16 space-y-12" data-reveal>
      <div>
        <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
          Core Engineering Challenges &amp; Production Solutions
        </h2>
        <p class="mt-3 text-base text-white/70">
          Overcoming platform quotas, data contamination, and mobile constraints without expanding infrastructure budget.
        </p>
      </div>

      <!-- Challenge 1 -->
      <div class="rounded-2xl border border-white/10 bg-[#151d27] p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/20 text-sm font-bold text-primary">
            1
          </span>
          <h3 class="font-serif text-xl font-semibold text-white">
            Overcoming Vercel’s 100-Deploy/Day Limit Trap (ADR-005)
          </h3>
        </div>
        <div class="mt-4 space-y-3 text-sm leading-6 text-white/80">
          <p>
            <strong>The Problem:</strong> The scheduled GitHub Actions workflows run every 10 minutes to ingest fresh
            earthquake and power updates, committing flat snapshots directly to the repository (~150 commits/day). On
            Vercel’s Hobby tier, a strict quota of 100 deployments per day meant automated snapshot commits would exhaust
            the build quota within 16 hours, freezing production deployments.
          </p>
          <p>
            <strong>The Architectural Solution:</strong> Rather than paying for enterprise infrastructure, we decoupled
            data persistence from deployments. We configured Vercel’s Ignored Build Step using an intelligent bash script
            (<code class="rounded bg-black/40 px-1.5 py-0.5 text-primary">scripts/vercel-ignore-build.sh</code>):
          </p>
          <div class="rounded-lg bg-black/50 p-4 font-mono text-xs text-emerald-400">
            git diff --quiet HEAD^ HEAD -- . ':(exclude)data'
          </div>
          <p>
            When a commit only touches files inside <code class="text-white">data/</code>, Vercel immediately exits with
            code 0, skipping the build. When application code or styles change, the build executes normally. Daily
            automated deployment consumption dropped from 150/day to <strong>zero</strong>.
          </p>
        </div>
      </div>

      <!-- Challenge 2 -->
      <div class="rounded-2xl border border-white/10 bg-[#151d27] p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/20 text-sm font-bold text-primary">
            2
          </span>
          <h3 class="font-serif text-xl font-semibold text-white">
            Edge-Cached Dynamic Snapshot Distribution &amp; Stale-While-Revalidate
          </h3>
        </div>
        <div class="mt-4 space-y-3 text-sm leading-6 text-white/80">
          <p>
            <strong>The Implementation:</strong> To serve fresh snapshots without rebuilding the frontend, serverless
            API routes (<code class="rounded bg-black/40 px-1.5 py-0.5 text-primary">/api/power</code> and
            <code class="rounded bg-black/40 px-1.5 py-0.5 text-primary">/api/earthquakes</code>) dynamically fetch the
            latest snapshots from GitHub’s Raw Content CDN at runtime.
          </p>
          <p>
            To eliminate upstream rate-limiting and protect against high traffic, endpoints emit edge caching headers:
            <code class="rounded bg-black/40 px-1.5 py-0.5 text-primary">Cache-Control: s-maxage=60, stale-while-revalidate=300</code>.
            Vercel’s global Edge CDN caches responses for 60 seconds and serves stale responses instantly for 5 minutes
            while fetching fresh data in the background. Even under heavy concurrent spikes, serverless functions execute
            at most once per minute (~1,440/day maximum, well under the 100,000 monthly free allowance).
          </p>
          <p>
            <strong>Fail-Safe Fallbacks:</strong> If GitHub Raw is unreachable, the API routes gracefully return bundled
            offline fixtures with explicit warning indicators. The application never fails silently or returns raw 500
            errors.
          </p>
        </div>
      </div>

      <!-- Challenge 3 -->
      <div class="rounded-2xl border border-white/10 bg-[#151d27] p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/20 text-sm font-bold text-primary">
            3
          </span>
          <h3 class="font-serif text-xl font-semibold text-white">
            Deterministic Test Suite Isolation &amp; SHA-256 Data Guards
          </h3>
        </div>
        <div class="mt-4 space-y-3 text-sm leading-6 text-white/80">
          <p>
            <strong>The Risk:</strong> During local testing, parser tests running via Vitest executed child processes
            that risked mutating authentic production snapshots in <code class="text-white">data/</code>, potentially
            causing developers to commit historical fixture data as live data.
          </p>
          <p>
            <strong>The Guard Mechanism:</strong> We implemented <code class="text-primary">WATCH_CEBU_DATA_DIR</code>
            runtime isolation, redirecting test fixtures to isolated temporary directories. Furthermore, an automated
            global guard calculates SHA-256 hashes of all files in <code class="text-white">data/</code> before and
            after every test run—failing the test suite immediately if any test causes unintentional file mutation. All
            <strong>270 tests across 22 suites</strong> run deterministically with zero git working tree pollution.
          </p>
        </div>
      </div>
    </section>

    <!-- Mobile-First Civic Ergonomics & Accessibility -->
    <section class="mt-16 space-y-6" data-reveal>
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
        Mobile-First Civic Ergonomics (WCAG 2.2 AA Compliant)
      </h2>
      <p class="text-base leading-7 text-white/80">
        During emergency situations, mobile phones with poor cellular reception and low battery are the primary devices
        used by citizens. Watch Cebu was engineered with strict ergonomic standards:
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-white/10 bg-[#151d27] p-5">
          <h4 class="font-semibold text-white">Clamped Viewport Chrome</h4>
          <p class="mt-2 text-sm leading-6 text-white/70">
            A 52px top bar and 56px bottom navigation ensure over 80% of screen height remains dedicated to the Leaflet map
            canvas on small devices like iPhone SE.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-[#151d27] p-5">
          <h4 class="font-semibold text-white">44×44px Touch Targets</h4>
          <p class="mt-2 text-sm leading-6 text-white/70">
            Every interactive control, map pin, date filter tab, and drawer close button adheres to WCAG 2.2 AA touch target
            sizes, preventing miss-clicks during hurried interactions.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-[#151d27] p-5">
          <h4 class="font-semibold text-white">Zero iOS Safari Auto-Zooming</h4>
          <p class="mt-2 text-sm leading-6 text-white/70">
            All text search inputs use a strict 16px minimum font size to prevent iOS Safari from triggering disruptive
            automatic viewport zooms on focus.
          </p>
        </div>
        <div class="rounded-xl border border-white/10 bg-[#151d27] p-5">
          <h4 class="font-semibold text-white">Lightweight Forecast Drawer</h4>
          <p class="mt-2 text-sm leading-6 text-white/70">
            Replaced heavy Doppler radar imagery (which often fails on 3G connections) with a lightweight, slide-down
            24-hour weather horizon showing rain chance and wind metrics.
          </p>
        </div>
      </div>
    </section>

    <!-- Visual Walkthrough Gallery -->
    <section class="mt-16 space-y-8" data-reveal>
      <div>
        <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
          Visual Interface Walkthrough
        </h2>
        <p class="mt-2 text-base text-white/70">
          Clean control-room typography, high-contrast dark theme, and verified municipal data layers.
        </p>
      </div>

      <div class="grid gap-10">
        {
          galleryScreens.map((screen) => (
            <figure class="overflow-hidden rounded-2xl border border-white/10 bg-[#151d27] p-4 sm:p-6">
              <a
                href={screen.src}
                target="_blank"
                rel="noopener noreferrer"
                class="group block overflow-hidden rounded-xl border border-white/10 bg-black"
                aria-label={`Open full size ${screen.alt}`}
              >
                <Image
                  src={screen.src}
                  alt={screen.alt}
                  width="1440"
                  height="900"
                  class="w-full object-cover transition duration-300 group-hover:scale-[1.01]"
                />
              </a>
              <figcaption class="mt-4">
                <h3 class="font-serif text-lg font-semibold text-white">{screen.title}</h3>
                <p class="mt-1 text-sm text-white/70">{screen.description}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- Technologies Table -->
    <section class="mt-16" data-reveal>
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">
        Complete Technology Architecture
      </h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-white/10">
        <table class="w-full text-left text-sm text-white/80">
          <thead class="border-b border-white/10 bg-white/5 text-xs font-semibold uppercase text-primary">
            <tr>
              <th scope="col" class="px-6 py-4">Architecture Layer</th>
              <th scope="col" class="px-6 py-4">Technology Selection</th>
              <th scope="col" class="px-6 py-4">Engineering Rationale</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10 bg-[#151d27]/60">
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Frontend Runtime</td>
              <td class="px-6 py-4">TypeScript, Vite 7, HTML5, Vanilla CSS3</td>
              <td class="px-6 py-4 text-white/70">Eliminates heavy frontend framework overhead, achieving ~78 kB gzipped footprint</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Geospatial Engine</td>
              <td class="px-6 py-4">Leaflet 1.9.4, CartoDB Dark Matter</td>
              <td class="px-6 py-4 text-white/70">High-performance canvas rendering with strict geographic bounding to Metro Cebu</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Edge Backend</td>
              <td class="px-6 py-4">Vercel Serverless Edge Functions, Node.js</td>
              <td class="px-6 py-4 text-white/70">Sub-second API latency with stale-while-revalidate edge caching</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Automation Pipelines</td>
              <td class="px-6 py-4">GitHub Actions (10-minute crons)</td>
              <td class="px-6 py-4 text-white/70">Automated scraping and flat JSON snapshot updates at zero server maintenance cost</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Scraping &amp; Ingestion</td>
              <td class="px-6 py-4">Cheerio, Native Fetch, Axios</td>
              <td class="px-6 py-4 text-white/70">Resilient HTML parsing, NLP street regex, and SHA-256 deduplication</td>
            </tr>
            <tr>
              <td class="px-6 py-4 font-semibold text-white">Test Suite &amp; QA</td>
              <td class="px-6 py-4">Vitest (270 tests), Chrome DevTools Protocol (CDP)</td>
              <td class="px-6 py-4 text-white/70">100% parser coverage, mobile viewport audits, and data directory hash validation</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Footer CTA -->
    <footer class="mt-20 border-t border-white/10 pt-10 text-center" data-reveal>
      <h3 class="font-serif text-2xl font-bold text-white">
        Explore Watch Cebu Live in Production
      </h3>
      <p class="mx-auto mt-2 max-w-xl text-sm text-white/70">
        Experience the live multi-hazard dashboard, inspect the open-source repository, or connect for full-stack engineering collaborations.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4 text-sm font-semibold">
        <a
          href="https://watch-cebu.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-primary px-6 py-3 text-black transition hover:bg-primary/90"
        >
          Launch Watch Cebu ↗
        </a>
        <a
          href="https://github.com/Sceyo/Watch-Cebu"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-white/20 bg-white/5 px-6 py-3 text-white transition hover:bg-white/10"
        >
          GitHub Repository ↗
        </a>
        <a
          href="/#projects"
          class="rounded-xl border border-white/10 px-6 py-3 text-white/70 transition hover:text-white"
        >
          Back to Portfolio
        </a>
      </div>
    </footer>
  </article>
</Layout>
