---
interface Props {
  resumeUrl?: string;
}

const { resumeUrl = "/francis-aliser-resume.pdf" } = Astro.props;
---

<!-- Resume Preview Modal Overlay -->
<div
  id="resume-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-3 sm:p-5 md:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Resume Preview Modal"
>
  <!-- Backdrop Blur with fade -->
  <div
    id="resume-modal-backdrop"
    class="fixed inset-0 bg-black/85 backdrop-blur-md transition-opacity duration-300"
    aria-hidden="true"
  >
  </div>

  <!-- Modal Card Dialog -->
  <div
    id="resume-modal-card"
    class="relative z-10 flex h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-3xl border border-white/15 bg-[#151d27] shadow-2xl shadow-black/80 transition-all duration-300"
  >
    <!-- Upper Control Header (Matches Portfolio Typography) -->
    <div
      class="flex items-center justify-between border-b border-white/10 bg-[#0e141b]/95 px-5 py-3.5 backdrop-blur"
    >
      <div class="flex items-center gap-2.5">
        <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
        <h3 class="font-serif text-sm sm:text-base font-semibold tracking-normal text-white">
          Francis Aliser <span class="font-sans text-xs sm:text-sm font-normal text-neutral">· Résumé</span>
        </h3>
      </div>

      <!-- Controls: Open in New Tab & Close (Full screen button removed as requested) -->
      <div class="flex items-center gap-2">
        <!-- Open External In New Tab -->
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-neutral transition hover:border-white/25 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
          title="Open in new tab"
          aria-label="Open resume in new tab"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>

        <!-- Close Button (X) -->
        <button
          type="button"
          id="resume-close-icon-btn"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-neutral transition hover:border-white/25 hover:bg-red-500/15 hover:text-red-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
          title="Close resume preview"
          aria-label="Close modal"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Center Resume Viewer -->
    <div class="relative flex-1 bg-[#1a2330] p-2 sm:p-4">
      <div
        class="h-full w-full overflow-hidden rounded-2xl bg-white shadow-2xl"
      >
        <iframe
          id="resume-iframe"
          data-src={`${resumeUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`}
          src="about:blank"
          class="h-full w-full border-0"
          title="Francis Aliser Resume"
        ></iframe>
      </div>
    </div>

    <!-- Bottom Action Bar (Follows Portfolio Typography & Button System) -->
    <div
      class="flex flex-wrap items-center justify-center gap-3.5 border-t border-white/10 bg-[#0e141b]/95 px-5 py-4"
    >
      <a
        href={resumeUrl}
        download="Francis-Aliser-Resume.pdf"
        id="resume-download-btn"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 font-sans text-xs sm:text-sm font-semibold text-white shadow-md shadow-primary/25 transition-all duration-200 hover:bg-blue-500 hover:shadow-xl hover:shadow-primary/35 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        <span>Download Resume</span>
      </a>

      <button
        type="button"
        id="resume-close-btn"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-2.5 font-sans text-xs sm:text-sm font-semibold text-neutral transition-all duration-200 hover:border-white/30 hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span>Close</span>
      </button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("resume-modal");
  const backdrop = document.getElementById("resume-modal-backdrop");
  const iframe = document.getElementById("resume-iframe") as HTMLIFrameElement | null;
  const closeIconBtn = document.getElementById("resume-close-icon-btn");
  const closeBtn = document.getElementById("resume-close-btn");

  function openResumeModal() {
    if (!modal) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";

    // Lazy-load iframe source on first open
    if (iframe && iframe.src === "about:blank") {
      const dataSrc = iframe.getAttribute("data-src");
      if (dataSrc) iframe.src = dataSrc;
    }
  }

  function closeResumeModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  // Hook all triggers with [data-open-resume]
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const trigger = target?.closest("[data-open-resume]");
    if (trigger) {
      e.preventDefault();
      openResumeModal();
    }
  });

  closeIconBtn?.addEventListener("click", closeResumeModal);
  closeBtn?.addEventListener("click", closeResumeModal);
  backdrop?.addEventListener("click", closeResumeModal);

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeResumeModal();
    }
  });
</script>
