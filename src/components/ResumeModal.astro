---
interface Props {
  resumeUrl?: string;
}

const { resumeUrl = "/francis-aliser-resume.pdf" } = Astro.props;
---

<!-- Resume Preview Modal Overlay -->
<div
  id="resume-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-3 sm:p-5 md:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Resume Preview Modal"
>
  <!-- Backdrop Blur with fade -->
  <div
    id="resume-modal-backdrop"
    class="fixed inset-0 bg-black/85 backdrop-blur-md transition-opacity duration-300"
    aria-hidden="true"
  >
  </div>

  <!-- Modal Card Dialog -->
  <div
    id="resume-modal-card"
    class="relative z-10 flex h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-white/15 bg-[#151d27] shadow-2xl shadow-black/80 transition-all duration-300"
  >
    <!-- Upper Right Control Header -->
    <div
      class="flex items-center justify-between border-b border-white/10 bg-[#0e141b]/90 px-4 py-3 backdrop-blur"
    >
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
        <span class="font-mono text-xs font-semibold tracking-wider text-white/70 uppercase">
          Francis Aliser — Résumé (PDF)
        </span>
      </div>

      <!-- Control Buttons (Fullscreen, New Tab, Close) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Fullscreen Button -->
        <button
          type="button"
          id="resume-fullscreen-btn"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/70 transition hover:bg-white/15 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
          title="Toggle Full Screen"
          aria-label="Toggle Full Screen"
        >
          <!-- Expand Icon -->
          <svg
            id="fullscreen-expand-icon"
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
            ></path>
          </svg>
          <!-- Compress Icon (Hidden by default) -->
          <svg
            id="fullscreen-compress-icon"
            class="hidden h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 9L4 4m0 5h5m-5 0V4m11 5h5m0 0L15 9m5 0V4m-5 11l5 5m0-5v5m0 0h-5m-6-5l-5 5m0 0h5m-5 0v-5"
            ></path>
          </svg>
        </button>

        <!-- Open External In New Tab -->
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/70 transition hover:bg-white/15 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
          title="Open in new tab"
          aria-label="Open resume in new tab"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>

        <!-- Close Button (X) -->
        <button
          type="button"
          id="resume-close-icon-btn"
          class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/70 transition hover:bg-red-500/20 hover:text-red-400 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary"
          title="Close resume preview"
          aria-label="Close modal"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Center Resume Viewer -->
    <div class="relative flex-1 bg-[#1a2330] p-2 sm:p-4">
      <div
        class="h-full w-full overflow-hidden rounded-xl bg-white shadow-2xl"
      >
        <iframe
          id="resume-iframe"
          data-src={`${resumeUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`}
          src="about:blank"
          class="h-full w-full border-0"
          title="Francis Aliser Resume"
        ></iframe>
      </div>
    </div>

    <!-- Bottom Action Bar (Matching User Reference Image) -->
    <div
      class="flex flex-wrap items-center justify-center gap-3 border-t border-white/10 bg-[#0e141b]/95 px-4 py-3.5"
    >
      <a
        href={resumeUrl}
        download="Francis-Aliser-Resume.pdf"
        id="resume-download-btn"
        class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white px-5 py-2.5 font-mono text-xs font-semibold text-black shadow-md transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        <span>download cv</span>
      </a>

      <button
        type="button"
        id="resume-close-btn"
        class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-2.5 font-mono text-xs font-semibold text-white/90 shadow-md transition hover:bg-white/15 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <span>close</span>
      </button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("resume-modal");
  const modalCard = document.getElementById("resume-modal-card");
  const backdrop = document.getElementById("resume-modal-backdrop");
  const iframe = document.getElementById("resume-iframe") as HTMLIFrameElement | null;
  const fullscreenBtn = document.getElementById("resume-fullscreen-btn");
  const expandIcon = document.getElementById("fullscreen-expand-icon");
  const compressIcon = document.getElementById("fullscreen-compress-icon");
  const closeIconBtn = document.getElementById("resume-close-icon-btn");
  const closeBtn = document.getElementById("resume-close-btn");

  let isFullscreen = false;

  function openResumeModal() {
    if (!modal) return;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";

    // Lazy-load iframe source on first open
    if (iframe && iframe.src === "about:blank") {
      const dataSrc = iframe.getAttribute("data-src");
      if (dataSrc) iframe.src = dataSrc;
    }
  }

  function closeResumeModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";

    // Exit fullscreen if active
    if (isFullscreen) {
      toggleFullscreen();
    }
  }

  function toggleFullscreen() {
    if (!modalCard) return;

    isFullscreen = !isFullscreen;

    if (isFullscreen) {
      modalCard.classList.remove("max-w-4xl", "h-[90vh]", "rounded-2xl");
      modalCard.classList.add("fixed", "inset-0", "h-full", "w-full", "rounded-none", "z-50");
      expandIcon?.classList.add("hidden");
      compressIcon?.classList.remove("hidden");
    } else {
      modalCard.classList.add("max-w-4xl", "h-[90vh]", "rounded-2xl");
      modalCard.classList.remove("fixed", "inset-0", "h-full", "w-full", "rounded-none", "z-50");
      expandIcon?.classList.remove("hidden");
      compressIcon?.classList.add("hidden");
    }
  }

  // Hook all triggers with [data-open-resume]
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const trigger = target?.closest("[data-open-resume]");
    if (trigger) {
      e.preventDefault();
      openResumeModal();
    }
  });

  fullscreenBtn?.addEventListener("click", toggleFullscreen);
  closeIconBtn?.addEventListener("click", closeResumeModal);
  closeBtn?.addEventListener("click", closeResumeModal);
  backdrop?.addEventListener("click", closeResumeModal);

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeResumeModal();
    }
  });
</script>
