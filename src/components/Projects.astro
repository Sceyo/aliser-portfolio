---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

function getDisplayDomain(url?: string): string | null {
  if (!url) return null;
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes("drive.google.com")) {
      return "drive preview";
    }
    return parsed.hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}
---

<Section
  index="01"
  text="Featured Projects"
  href="projects"
  subtitle="Production applications, client capstones, and civic infrastructure built for real-world operations."
>
  <div class="space-y-12">
    {
      projects.map((project) => {
        const domain = getDisplayDomain(project.linkPreview);
        const isPannEcosystem =
          project.name.startsWith("PANN") || project.name === "Ramyeon Corner";

        return (
          <article
            class="project-card overflow-hidden rounded-3xl border border-white/10 bg-[#151d27] shadow-2xl shadow-black/40 transition-all duration-300"
            data-reveal
          >
            <details class="group/project">
              <summary
                class="block cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary [&::-webkit-details-marker]:hidden"
                data-analytics-event="project_open"
                data-analytics-project={project.name}
              >
                <!-- 1. Top Section: Full-Width Prominent Screenshot Banner -->
                <div class="relative aspect-[16/10] sm:aspect-video w-full overflow-hidden border-b border-white/10 bg-[#0a1017]">
                  <Image
                    class="h-full w-full object-cover object-top transition duration-500 group-hover/project:scale-[1.01]"
                    src={project.image}
                    alt={`${project.name} interface preview`}
                    width="1024"
                    height="640"
                  />

                  <!-- Bottom-Left URL / Domain Badge (Matching Reference Screenshot) -->
                  {domain && (
                    <div class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-black/75 px-3.5 py-1 text-xs font-mono font-medium text-white/90 backdrop-blur shadow-lg">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true" />
                      <span>{domain}</span>
                    </div>
                  )}
                </div>

                <!-- 2. Bottom Content Section (Matching Reference Screenshot) -->
                <div class="p-6 sm:p-8 md:p-10">
                  <!-- Header Row: Title on Left, Badges & Plus (+) Button on Right -->
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-white">
                        {project.name}
                      </h3>
                      <!-- Tagline / Subtitle directly below Title -->
                      <p class="mt-1.5 text-sm sm:text-base font-medium text-primary">
                        {project.projectType}
                      </p>
                    </div>

                    <!-- Right Controls: Badges and Interactive (+) Sign Button -->
                    <div class="flex items-center gap-3 self-start sm:self-auto">
                      {isPannEcosystem && (
                        <span class="rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 font-mono text-xs text-amber-300">
                          PANN Ecosystem
                        </span>
                      )}
                      {project.featured && (
                        <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-400">
                          Featured
                        </span>
                      )}

                      <!-- User requested: "+" sign on right side with rotate dropdown effect -->
                      <span
                        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-xl font-medium text-primary shadow-sm transition-all duration-300 group-open/project:rotate-45 group-open/project:bg-primary group-open/project:text-white group-hover/project:border-primary/50 group-hover/project:bg-white/10"
                        aria-hidden="true"
                        title="Toggle project deep dive"
                      >
                        +
                      </span>
                    </div>
                  </div>

                  <!-- Summary Paragraph (Short explanation of problem & what you implemented) -->
                  <p class="mt-4 text-sm sm:text-base text-neutral leading-relaxed max-w-4xl">
                    {project.summary}
                  </p>

                  <!-- Tech Stack Pills -->
                  <ul
                    class="mt-6 flex flex-wrap gap-2"
                    aria-label={`${project.name} technologies`}
                  >
                    {project.technologies.map((tech) => (
                      <li class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-white/80">
                        {tech}
                      </li>
                    ))}
                  </ul>

                  <!-- Direct Actions Row (Live Demo, Source Code, Case Study) -->
                  <div class="mt-6 flex flex-wrap items-center gap-6 border-t border-white/5 pt-5 text-sm font-semibold text-white">
                    {project.linkPreview && (
                      <a
                        href={project.linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-analytics-event="project_click"
                        data-analytics-project={project.name}
                        data-analytics-destination="live"
                        class="project-action-link inline-flex items-center gap-1.5 text-primary transition hover:text-blue-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                      >
                        Live demo <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    {project.linkSource && (
                      <a
                        href={project.linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-analytics-event="project_click"
                        data-analytics-project={project.name}
                        data-analytics-destination="source"
                        class="project-action-link inline-flex items-center gap-1.5 text-white/80 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                      >
                        Source code <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    {project.caseStudyUrl && (
                      <a
                        href={project.caseStudyUrl}
                        data-analytics-event="project_click"
                        data-analytics-project={project.name}
                        data-analytics-destination="case_study"
                        class="project-action-link inline-flex items-center gap-1.5 text-emerald-400 transition hover:text-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                      >
                        Case study <span aria-hidden="true">↗</span>
                      </a>
                    )}

                    <span class="ml-auto text-xs text-white/40 hidden sm:inline-block">
                      Click card or + for deep dive
                    </span>
                  </div>
                </div>
              </summary>

              <!-- 3. Dropdown Drawer: Revealed on click with smooth animation -->
              <div class="border-t border-white/10 bg-black/25 p-6 sm:p-8 md:p-10">
                <div class="grid gap-8 lg:grid-cols-12">
                  <!-- Gallery Column -->
                  <div class="space-y-4 lg:col-span-6 lg:border-r lg:border-white/10 lg:pr-8">
                    <div class="flex items-center justify-between">
                      <h4 class="font-serif text-lg font-semibold text-white">
                        Inside {project.name}
                      </h4>
                      <span class="text-xs text-neutral">
                        {project.gallery.length} screens
                      </span>
                    </div>

                    <div class="grid gap-4">
                      {project.gallery.map((galleryImage, imageIndex) => (
                        <figure>
                          <a
                            href={galleryImage.src}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group/image relative block overflow-hidden rounded-xl border border-white/10 bg-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                            aria-label={`Open full-size ${galleryImage.alt}`}
                          >
                            <Image
                              class="aspect-video w-full object-cover object-top transition duration-300 group-hover/image:scale-[1.01]"
                              src={galleryImage.src}
                              alt={galleryImage.alt}
                              width="736"
                              height="414"
                            />
                            <span
                              class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-black/75 text-sm font-medium text-white shadow-lg backdrop-blur transition group-hover/image:bg-primary"
                              aria-hidden="true"
                            >
                              +
                            </span>
                            <span
                              class="absolute bottom-3 left-3 rounded-full bg-black/75 px-2.5 py-0.5 text-[0.7rem] font-semibold text-white/80 backdrop-blur"
                              aria-hidden="true"
                            >
                              {String(imageIndex + 1).padStart(2, "0")}
                            </span>
                          </a>
                          <figcaption class="mt-1.5 text-xs text-neutral">
                            {galleryImage.caption}
                          </figcaption>
                        </figure>
                      ))}
                    </div>
                  </div>

                  <!-- Details & Engineering Highlights Column -->
                  <div class="space-y-6 lg:col-span-6 lg:pl-2">
                    <dl class="grid gap-4 border-b border-white/10 pb-6 sm:grid-cols-2">
                      <div>
                        <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">
                          My role
                        </dt>
                        <dd class="mt-1 text-sm font-medium text-white">{project.role}</dd>
                      </div>
                      <div>
                        <dt class="text-xs font-semibold tracking-wider text-white/45 uppercase">
                          Status
                        </dt>
                        <dd class="mt-1 text-sm font-medium text-white">{project.status}</dd>
                      </div>
                    </dl>

                    <div>
                      <h5 class="text-xs font-semibold tracking-wider text-white/45 uppercase mb-2">
                        What I Contributed
                      </h5>
                      <p class="text-sm leading-relaxed text-neutral">
                        {project.contribution}
                      </p>
                    </div>

                    <div>
                      <h5 class="text-xs font-semibold tracking-wider text-white/45 uppercase mb-3">
                        Key Results &amp; Verification
                      </h5>
                      <ul class="space-y-3">
                        {project.results.map((result) => (
                          <li class="relative pl-6 text-sm leading-relaxed text-white/85 before:absolute before:top-2 before:left-0 before:h-2 before:w-2 before:rounded-full before:bg-primary">
                            {result}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </details>
          </article>
        );
      })
    }
  </div>
</Section>

<script>
  // Prevent click on action links inside summary from toggling details
  document.querySelectorAll(".project-action-link").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  });
</script>

<style>
  .project-card {
    --glare-x: 50%;
    --glare-y: 20%;
    position: relative;
    isolation: isolate;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .project-card::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: radial-gradient(
      36rem circle at var(--glare-x) var(--glare-y),
      rgb(59 130 246 / 14%),
      transparent 45%
    );
    opacity: 0;
    pointer-events: none;
    content: "";
    transition: opacity 250ms ease;
  }

  .project-card > details {
    position: relative;
    z-index: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: translateY(-3px);
      border-color: rgb(96 165 250 / 28%);
      box-shadow: 0 28px 70px rgb(0 0 0 / 40%);
    }

    .project-card:hover::before {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-card:hover {
      transform: none;
    }
  }
</style>
