---
interface Props {
  text: string;
  href: string;
  index?: string;
  subtitle?: string;
  class?: string;
}

const { text, href, index, subtitle, class: className = "" } = Astro.props;
---

<section id={href} class={`py-20 md:py-24 ${className}`}>
  <div class="mb-12 border-t border-white/10 pt-8" data-reveal>
    {
      index && (
        <div class="mb-3 flex items-center gap-2.5 font-mono text-xs font-semibold tracking-widest text-primary uppercase">
          <span>{index}</span>
          <span class="text-white/30" aria-hidden="true">
            /
          </span>
          <span class="text-white/60">{text}</span>
        </div>
      )
    }
    <h2
      class="font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl"
    >
      {text}
    </h2>
    {
      subtitle && (
        <p class="mt-3.5 max-w-2xl text-base text-neutral leading-relaxed">
          {subtitle}
        </p>
      )
    }
  </div>
  <slot />
</section>
