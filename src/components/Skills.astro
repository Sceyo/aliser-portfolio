---
import Section from "./Section.astro";
import TechIcon from "./TechIcon.astro";

interface Props {
  skillCategories: {
    languages?: string[];
    frontend?: string[];
    backend?: string[];
    databases?: string[];
    tools?: string[];
    aiTools?: string[];
    other?: string[];
  };
  certifications: {
    name: string;
    issuer: string;
    date: string;
    featured?: boolean;
    description?: string;
    credentialUrl?: string;
  }[];
  additionalCoursework?: {
    name: string;
    issuer: string;
    date: string;
  }[];
}

const {
  skillCategories,
  certifications,
  additionalCoursework = [],
} = Astro.props;

// Category metadata with icons and labels
const categoryMeta: Record<
  string,
  { label: string; iconPath: string; color: string }
> = {
  languages: {
    label: "Languages",
    iconPath: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
    color: "text-amber-400",
  },
  frontend: {
    label: "Frontend & UI",
    iconPath: "M4 6a2 2 0 012-2h12a2 2 0 012 2v7a2 2 0 01-2 2H6a2 2 0 01-2-2V6z M14 15v4m-4 0h8",
    color: "text-sky-400",
  },
  backend: {
    label: "Backend & Systems",
    iconPath: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2",
    color: "text-emerald-400",
  },
  databases: {
    label: "Databases & Storage",
    iconPath: "M4 7v10c0 2.2 3.6 4 8 4s8-1.8 8-4V7M4 7c0 2.2 3.6 4 8 4s8-1.8 8-4M4 7c0-2.2 3.6-4 8-4s8 1.8 8 4m0 5c0 2.2-3.6 4-8 4s-8-1.8-8-4",
    color: "text-blue-400",
  },
  tools: {
    label: "DevOps & Tooling",
    iconPath: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
    color: "text-purple-400",
  },
  aiTools: {
    label: "AI-Assisted Engineering",
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
    color: "text-amber-300",
  },
  other: {
    label: "Operations & Infrastructure",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    color: "text-teal-400",
  },
};
---

<Section text="Skills & Credentials" href="skills">
  <!-- Skills Categories Grid -->
  <div class="grid gap-6 md:grid-cols-2" data-reveal>
    {
      Object.entries(skillCategories).map(([key, skills]) => {
        if (!skills || skills.length === 0) return null;
        const meta = categoryMeta[key] || {
          label: key,
          iconPath: "M5 13l4 4L19 7",
          color: "text-primary",
        };

        return (
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#151d27]/70 p-5 backdrop-blur transition-all duration-300 hover:border-primary/40 hover:bg-[#151d27]/90 hover:shadow-xl hover:shadow-primary/5">
            <!-- Header with category icon and count -->
            <div class="mb-4 flex items-center justify-between border-b border-white/5 pb-3">
              <div class="flex items-center gap-2.5">
                <span class={`flex h-7 w-7 items-center justify-center rounded-lg bg-white/5 ${meta.color}`}>
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={meta.iconPath} />
                  </svg>
                </span>
                <h3 class="font-serif text-lg font-semibold text-white">
                  {meta.label}
                </h3>
              </div>
              <span class="rounded-full bg-white/5 px-2.5 py-0.5 text-xs font-mono font-medium text-white/50">
                {skills.length}
              </span>
            </div>

            <!-- Skills Chip Grid -->
            <ul class="flex flex-wrap gap-2.5">
              {skills.map((skill) => (
                <li class="group/chip inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2 text-xs font-medium text-white/90 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-white/[0.08] hover:text-white hover:shadow-md">
                  <span class="shrink-0 transition-transform duration-200 group-hover/chip:scale-110">
                    <TechIcon name={skill} class="h-4 w-4" />
                  </span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>

  <!-- Selected Credentials Section -->
  <div class="mt-14" data-reveal>
    <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
      <div>
        <p class="text-xs font-semibold tracking-wider text-primary uppercase">Verified Knowledge</p>
        <h3 class="mt-1 font-serif text-2xl font-bold tracking-tight text-white">
          Selected Credentials
        </h3>
      </div>
      <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-mono text-white/60">
        {certifications.length} verified
      </span>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        certifications.map((cert) => (
          <li class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-[#151d27]/70 p-6 transition-all duration-300 hover:border-primary/40 hover:bg-[#151d27]/90 hover:shadow-xl hover:shadow-primary/5">
            <div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-primary/60 to-primary/10 group-hover:from-primary group-hover:to-blue-400" />
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    />
                  </svg>
                </div>
                <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-mono font-medium text-white/70">
                  {cert.date}
                </span>
              </div>

              <h4 class="mt-4 font-serif text-lg font-bold text-white group-hover:text-primary transition-colors">
                {cert.name}
              </h4>
              <p class="mt-1 text-xs font-medium text-white/60">
                Issued by <span class="text-white/80">{cert.issuer}</span>
              </p>

              {cert.description && (
                <p class="mt-3 text-xs leading-relaxed text-neutral">
                  {cert.description}
                </p>
              )}
            </div>

            {cert.credentialUrl && (
              <div class="mt-5 border-t border-white/5 pt-4">
                <a
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Verify ${cert.name} credential (opens in a new tab)`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary transition-colors hover:text-blue-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Verify Authenticity <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Additional Coursework -->
  {
    additionalCoursework.length > 0 && (
      <div class="mt-10 rounded-2xl border border-white/5 bg-white/[0.02] p-5" data-reveal>
        <div class="flex items-center gap-2 mb-3">
          <svg class="h-4 w-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <h4 class="font-serif text-xs font-semibold tracking-wider text-white/50 uppercase">
            Additional Coursework & Training
          </h4>
        </div>
        <p class="text-xs leading-relaxed text-white/60">
          {additionalCoursework.map((course, i) => (
            <>
              <span class="text-white/80">{course.name}</span>{" "}
              <span class="text-white/40">({course.issuer})</span>
              {i < additionalCoursework.length - 1 ? " • " : ""}
            </>
          ))}
        </p>
      </div>
    )
  }
</Section>
