---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="About Me" href="about">
  <div
    class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#151d27]/70 p-6 sm:p-9 md:p-10 backdrop-blur shadow-2xl transition-all duration-300 hover:border-primary/30"
    data-reveal
  >
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <!-- Left: Story & Highlights -->
      <div class="space-y-6 lg:col-span-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-3.5 py-1 text-xs font-semibold text-primary">
          <span class="h-2 w-2 rounded-full bg-primary animate-pulse" aria-hidden="true"></span>
          Full-Stack Developer &amp; Systems Engineer
        </div>

        <p class="text-base sm:text-lg leading-relaxed text-white/90">
          {description}
        </p>

        <!-- Quick Facts Pill Grid -->
        <div class="grid gap-3 pt-4 sm:grid-cols-3 border-t border-white/5">
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3.5">
            <dt class="text-[0.68rem] font-semibold tracking-wider text-white/40 uppercase">
              Education
            </dt>
            <dd class="mt-1 font-serif text-xs sm:text-sm font-semibold text-white">
              BS IT · Univ. of San Carlos
            </dd>
          </div>
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3.5">
            <dt class="text-[0.68rem] font-semibold tracking-wider text-white/40 uppercase">
              Location
            </dt>
            <dd class="mt-1 font-serif text-xs sm:text-sm font-semibold text-white">
              Cebu, Philippines (UTC+8)
            </dd>
          </div>
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3.5">
            <dt class="text-[0.68rem] font-semibold tracking-wider text-white/40 uppercase">
              Availability
            </dt>
            <dd class="mt-1 font-serif text-xs sm:text-sm font-semibold text-emerald-400">
              Open to Opportunities
            </dd>
          </div>
        </div>
      </div>

      <!-- Right: Portrait Presentation -->
      <div class="flex justify-center lg:col-span-4">
        <div class="relative w-full max-w-[240px] sm:max-w-[260px]">
          <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-black/50 p-2.5 shadow-2xl shadow-black/50 transition-all duration-300 hover:border-primary/40">
            <Image
              class="aspect-[4/5] w-full rounded-xl object-cover"
              src={image}
              width="260"
              height="325"
              alt={name}
            />
            <div class="mt-2.5 flex items-center justify-center gap-1.5 pb-0.5 text-center font-mono text-[0.72rem] font-medium text-white/60">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              {name}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
