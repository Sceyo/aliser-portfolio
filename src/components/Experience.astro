---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section
  index="02"
  text="Work Experience"
  href="experience"
  subtitle="Hands-on enterprise IT operations, automation workflows, and production infrastructure."
>
  <div class="space-y-8" data-reveal>
    {
      experience.map(({ company, position, startDate, endDate, summary }) => {
        const isLexmark = company.toLowerCase().includes("lexmark");

        return (
          <article class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#151d27]/70 p-6 sm:p-8 md:p-10 backdrop-blur shadow-xl transition-all duration-300 hover:border-primary/30">
            <!-- Header bar with position and timeline -->
            <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between border-b border-white/10 pb-6">
              <div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary uppercase tracking-wider">
                  Enterprise Internship
                </span>
                <h3 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-white">
                  {company}
                </h3>
                <h4 class="mt-1 font-serif text-lg font-medium text-primary">
                  {position}
                </h4>
              </div>
              <span class="inline-flex self-start sm:self-auto items-center rounded-full border border-white/10 bg-white/5 px-3.5 py-1 text-xs font-mono font-medium text-white/70">
                {startDate} — {endDate}
              </span>
            </div>

            <!-- Standout Metric Highlight for Lexmark -->
            {isLexmark && (
              <div class="my-6 rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-5 sm:p-6">
                <div class="grid gap-4 sm:grid-cols-[auto_1fr] sm:items-center">
                  <div class="flex flex-col">
                    <span class="text-[0.68rem] font-mono font-bold tracking-widest text-emerald-400 uppercase">
                      Quantified Impact
                    </span>
                    <span class="font-mono text-2xl sm:text-3xl font-bold tracking-tight text-white">
                      5–15 min <span class="text-emerald-400">→</span> 1–2 min
                    </span>
                    <span class="text-xs text-white/60">
                      Daily manual tracking reduction per person
                    </span>
                  </div>
                  <p class="text-xs sm:text-sm text-neutral leading-relaxed sm:border-l sm:border-white/10 sm:pl-6">
                    Engineered an automated Microsoft Power Automate workflow for a 10-person operations team that calculated daily clock-out reminders and aggregated Friday work-hour reports, virtually eliminating manual tracking overhead.
                  </p>
                </div>
              </div>
            )}

            <!-- Summary List -->
            <div class="mt-6">
              <h5 class="text-xs font-semibold tracking-wider text-white/40 uppercase mb-4">
                Key Responsibilities & Contributions
              </h5>
              {Array.isArray(summary) ? (
                <ul class="space-y-3.5">
                  {summary.map((log) => (
                    <li class="relative pl-7 text-sm leading-relaxed text-neutral before:absolute before:top-1 before:left-0 before:flex before:h-4 before:w-4 before:items-center before:justify-center before:rounded-full before:bg-primary/20 before:text-[0.65rem] before:font-bold before:text-primary before:content-['✓']">
                      {log}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-sm leading-relaxed text-neutral">{summary}</p>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</Section>
