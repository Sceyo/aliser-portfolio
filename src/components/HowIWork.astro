---
import Section from "./Section.astro";

const workflowSteps = [
  {
    number: "01",
    phase: "Discovery & Understanding",
    tagline: "Listening first",
    summary:
      "Learning your vision, analyzing day-to-day operational workflows, and uncovering true requirements before writing a single line of code.",
    accentColor: "text-amber-400",
    borderColor: "group-hover:border-amber-400/50",
    bgAccent: "bg-amber-400/10",
  },
  {
    number: "02",
    phase: "Planning & Architecture",
    tagline: "Mapping the path",
    summary:
      "Structuring data flows, choosing the right minimal tech stack, mapping edge cases, and outlining clear milestones with no surprises.",
    accentColor: "text-sky-400",
    borderColor: "group-hover:border-sky-400/50",
    bgAccent: "bg-sky-400/10",
  },
  {
    number: "03",
    phase: "Development & Testing",
    tagline: "Iterative creation",
    summary:
      "Writing clean, modular code backed by automated testing, responsive mobile ergonomics, and frequent progress check-ins for direct feedback.",
    accentColor: "text-primary",
    borderColor: "group-hover:border-primary/50",
    bgAccent: "bg-primary/10",
  },
  {
    number: "04",
    phase: "Deployment & Launch",
    tagline: "Smooth delivery",
    summary:
      "Shipping to dependable edge and cloud platforms with performance optimization, automated build pipelines, and zero-downtime uptime.",
    accentColor: "text-emerald-400",
    borderColor: "group-hover:border-emerald-400/50",
    bgAccent: "bg-emerald-400/10",
  },
  {
    number: "05",
    phase: "Support & Evolution",
    tagline: "Long-term reliability",
    summary:
      "Providing straightforward handover documentation, proactive monitoring, and frictionless feature upgrades so systems stay dependable.",
    accentColor: "text-purple-400",
    borderColor: "group-hover:border-purple-400/50",
    bgAccent: "bg-purple-400/10",
  },
];

const engineeringTenets = [
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    title: "Deterministic Quality & Testing",
    badge: "530+ Tests",
    description:
      "If a critical path isn't tested, it's unfinished. Automated unit, simulation, and integration tests guarantee new updates never break existing reliability.",
    color: "text-emerald-400",
  },
  {
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
    title: "Zero-Cost Production Footprint",
    badge: "$0/mo Ops",
    description:
      "Maximizing serverless edge caching, static asset pipelines, and automated build filtering to operate dependable production apps on free-tier quotas.",
    color: "text-amber-400",
  },
  {
    icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
    title: "Offline & Field-Ready Resilience",
    badge: "WCAG 2.2 AA",
    description:
      "Engineered for spotty cellular networks and outdoor field environments with local storage, PWA tile caching, and high-contrast touch targets.",
    color: "text-sky-400",
  },
  {
    icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10",
    title: "Pragmatic Simplicity",
    badge: "Zero Bloat",
    description:
      "No unnecessary frameworks or SaaS lock-in. Tools are chosen strictly to solve real operational problems with minimal maintenance overhead.",
    color: "text-purple-400",
  },
];
---

<Section text="How I Work" href="how-i-work">
  <!-- Section Intro / Subtitle -->
  <p class="-mt-8 mb-10 max-w-2xl text-base text-neutral leading-relaxed" data-reveal>
    A collaborative, structured approach to turning ideas into reliable software—focusing on clear communication, disciplined planning, and long-term maintainability.
  </p>

  <!-- 5-Stage Process Stepper / Cards -->
  <div class="relative" data-reveal>
    <!-- Connecting visual line on desktop -->
    <div
      class="hidden lg:block absolute top-1/2 left-8 right-8 h-0.5 -translate-y-8 bg-gradient-to-r from-amber-400/20 via-primary/30 to-purple-400/20 z-0"
      aria-hidden="true"
    />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 relative z-10">
      {
        workflowSteps.map((step) => (
          <div
            class={`group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-[#151d27]/80 p-5 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:bg-[#151d27] hover:shadow-xl ${step.borderColor}`}
          >
            <!-- Top bar / badge -->
            <div>
              <div class="flex items-center justify-between">
                <span
                  class={`flex h-9 w-9 items-center justify-center rounded-xl font-mono text-sm font-extrabold ${step.bgAccent} ${step.accentColor}`}
                >
                  {step.number}
                </span>
                <span class="text-[0.7rem] font-semibold tracking-wider text-white/40 uppercase">
                  {step.tagline}
                </span>
              </div>

              <h3 class="mt-4 font-serif text-base font-bold text-white group-hover:text-white transition-colors">
                {step.phase}
              </h3>

              <p class="mt-2 text-xs leading-relaxed text-neutral">
                {step.summary}
              </p>
            </div>

            <!-- Bottom subtle indicator -->
            <div class="mt-4 pt-3 border-t border-white/5 flex items-center gap-1.5 text-[0.68rem] font-mono text-white/40">
              <span class={`h-1.5 w-1.5 rounded-full ${step.accentColor.replace("text-", "bg-")}`} />
              Phase {step.number}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Engineering Tenets Sub-Section -->
  <div class="mt-16" data-reveal>
    <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
      <div>
        <p class="text-xs font-semibold tracking-wider text-primary uppercase">Guiding Principles</p>
        <h3 class="mt-1 font-serif text-2xl font-bold tracking-tight text-white">
          Core Engineering Tenets
        </h3>
      </div>
      <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-mono text-white/60">
        Quality Standards
      </span>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        engineeringTenets.map((tenet) => (
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#151d27]/70 p-6 backdrop-blur transition-all duration-300 hover:border-primary/40 hover:bg-[#151d27]/90 hover:shadow-xl hover:shadow-primary/5">
            <div class="flex items-center justify-between">
              <span class={`flex h-10 w-10 items-center justify-center rounded-xl bg-white/5 ${tenet.color}`}>
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={tenet.icon} />
                </svg>
              </span>
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-[0.7rem] font-mono font-medium text-white/70">
                {tenet.badge}
              </span>
            </div>

            <h4 class="mt-4 font-serif text-base font-bold text-white group-hover:text-primary transition-colors">
              {tenet.title}
            </h4>

            <p class="mt-2 text-xs leading-relaxed text-neutral">
              {tenet.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
