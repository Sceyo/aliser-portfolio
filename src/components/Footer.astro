---
import { SITE_CONFIG, SITE_CONTENT } from "@config";

type Props = {
  author: string;
  socialLinks?: { text: string; href: string }[];
};

const { author } = Astro.props;
const currentYear = new Date().getFullYear();
const navLinks = SITE_CONFIG.navLinks || [];
const specialty = SITE_CONTENT.hero.specialty;
const email = SITE_CONTENT.hero.email || "francisaliserit@gmail.com";
---

<footer class="w-full border-t border-white/10 bg-[#0e141b] px-6 pt-16 pb-12 text-white">
  <div class="mx-auto max-w-5xl">
    <!-- Top 3-Column Layout -->
    <div class="grid gap-10 md:grid-cols-12 md:items-start md:justify-between">
      <!-- Left: Brand, Specialty & Summary (Follows our theme) -->
      <div class="space-y-3 md:col-span-5">
        <h3 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-white">
          {author}
        </h3>
        <p class="text-xs sm:text-sm font-medium text-primary">
          {specialty}
        </p>
        <p class="text-xs text-neutral leading-relaxed max-w-sm">
          Building dependable web systems for retail operations, automation, and real-time experiences.
        </p>
        <p class="text-xs text-white/40 pt-1">
          © {currentYear} {author}. All rights reserved.
        </p>
      </div>

      <!-- Center: Navigation (Follows our actual site sections) -->
      <div class="md:col-span-4 md:flex md:justify-center">
        <div class="space-y-3">
          <span class="block text-xs font-semibold tracking-wider text-white/40 uppercase">
            Navigation
          </span>
          <ul class="space-y-2 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-neutral transition-colors duration-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                  >
                    {link.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Right: Social Channels -->
      <div class="space-y-3 md:col-span-3 md:flex md:flex-col md:items-end">
        <span class="block text-xs font-semibold tracking-wider text-white/40 uppercase">
          Connect
        </span>
        <div class="flex items-center gap-2.5">
          <!-- GitHub -->
          <a
            href="https://github.com/Sceyo"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Francis Aliser on GitHub (opens in a new tab)"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white/80 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-white/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/francis-aliser/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Francis Aliser on LinkedIn (opens in a new tab)"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white/80 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-white/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.62 1.62 0 0 0-1.62 1.63c0 .9.72 1.63 1.62 1.63s1.62-.73 1.62-1.63c0-.9-.72-1.63-1.62-1.63z"
              ></path>
            </svg>
          </a>

          <!-- Instagram -->
          <a
            href="https://www.instagram.com/francisaliser/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Francis Aliser on Instagram (opens in a new tab)"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white/80 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-white/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${email}`}
            aria-label="Send email to Francis Aliser"
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white/80 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/50 hover:bg-white/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar (Matching our theme) -->
    <div class="mt-14 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-neutral">
      <div>
        Built with Astro &amp; Tailwind CSS
      </div>

      <div class="flex items-center gap-2 text-white/70">
        <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
        <span>Cebu, Philippines · UTC+8</span>
      </div>
    </div>
  </div>
</footer>
