---
import type { SiteConfig } from "@types";
import { SITE_CONTENT } from "@config";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author } = Astro.props;
const currentYear = new Date().getFullYear();
const email = SITE_CONTENT.hero.email || "francisaliserit@gmail.com";

const navItems = [
  { text: "~/projects", href: "#projects" },
  { text: "~/experience", href: "#experience" },
  { text: "~/skills", href: "#skills" },
  { text: "~/how-i-work", href: "#how-i-work" },
  { text: "~/about", href: "#about" },
  { text: "say-hi", href: "#contact" },
];
---

<footer class="relative isolate w-full border-t border-white/10 bg-[#0a0e15] px-6 pt-16 pb-12 text-white overflow-hidden">
  <!-- Subtle diagonal pinstripe texture matching reference -->
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.02) 0, rgba(255,255,255,0.02) 1px, transparent 0, transparent 20px);"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Top 3-Column Layout -->
    <div class="grid gap-10 md:grid-cols-12 md:items-start md:justify-between">
      <!-- Left: Brand, Tagline & Status -->
      <div class="space-y-3 md:col-span-5">
        <h3 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-amber-300">
          {author}
        </h3>
        <p class="text-xs sm:text-sm text-white/60 leading-relaxed font-mono">
          thanks for flipping through. building systems that don’t break.
        </p>
        <p class="text-xs text-white/40 font-mono">
          © {currentYear} all systems operational, code tested.
        </p>
      </div>

      <!-- Center: Terminal-Style Directory Links -->
      <div class="md:col-span-4 md:flex md:justify-center">
        <ul class="space-y-2.5 font-mono text-xs sm:text-sm">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-block text-white/60 transition-colors duration-200 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right: Social Icon Cards -->
      <div class="flex items-center gap-3 md:col-span-3 md:justify-end">
        <!-- GitHub -->
        <a
          href="https://github.com/Sceyo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Francis Aliser on GitHub (opens in a new tab)"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-amber-300/60 hover:bg-white/10 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/francis-aliser/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Francis Aliser on LinkedIn (opens in a new tab)"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-amber-300/60 hover:bg-white/10 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25a1.62 1.62 0 0 0-1.62 1.63c0 .9.72 1.63 1.62 1.63s1.62-.73 1.62-1.63c0-.9-.72-1.63-1.62-1.63z"
            ></path>
          </svg>
        </a>

        <!-- Email -->
        <a
          href={`mailto:${email}`}
          aria-label="Send email to Francis Aliser"
          class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-amber-300/60 hover:bg-white/10 hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Dashed Bar (Matching Reference) -->
    <div class="mt-14 pt-6 border-t border-dashed border-white/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-white/45">
      <div>
        built with astro &amp; tailwind on recycled pixels
      </div>

      <div class="flex items-center gap-2 text-white/55">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        <span>cebu, philippines · utc+8</span>
      </div>
    </div>
  </div>
</footer>
